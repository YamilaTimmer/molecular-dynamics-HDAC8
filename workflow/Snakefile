import glob
import os

configfile: "config.yaml"

DATA_DIR = config["data_dir"]

include: "rules/make_index.smk"
include: "rules/trajectory_conversion.smk"
include: "rules/pdb_dump.smk"

# Detect all variants
VARIANT_DIRS = [p for p in glob.glob(f"{DATA_DIR}/*") if os.path.isdir(p)]
VARIANTS = [os.path.basename(d) for d in VARIANT_DIRS]

rule all:
    input:
        expand(f"{DATA_DIR}/{{variant}}/index.ndx", variant=VARIANTS),
        expand(f"{DATA_DIR}/{{variant}}/output/{{variant}}-ion.xtc", variant=VARIANTS),
        expand(f"{DATA_DIR}/{{variant}}/output/{{variant}}-ion.pdb", variant=VARIANTS)
